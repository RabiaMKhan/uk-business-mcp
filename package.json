{
  "name": "uk-business-mcp",
  "version": "0.1.0",
  "description": "MCP server for UK business lookups: Companies House company data and postcodes.io locations",
  "type": "module",
  "private": true,
  "bin": {
    "uk-business-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node --env-file-if-exists=.env build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector@2.15.0 node --env-file-if-exists=.env build/index.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
